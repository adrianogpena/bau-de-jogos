#!/bin/sh
# Antes do push: confere que todo texto fixo do site tem áudio (texto novo ou alterado exige "npm run audio:narrador").
echo "Conferindo os áudios do narrador..."
npm test --silent || {
  echo "Push cancelado: gere os áudios que faltam com \"npm run audio:narrador\" e faça commit deles."
  exit 1
}
