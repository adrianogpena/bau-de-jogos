{
  "name": "bau-de-jogos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jogos infantis em português (PT-PT e PT-BR) para tablet",
  "scripts": {
    "dev": "vite --host",
    "servidor": "vite --host --port 5199 --strictPort",
    "dev:tablet": "node scripts/tablet.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/gerar-audio.mjs"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
